# Application Settings
# Localhost is detected automatically as development when these two variables
# are not configured. Always set them explicitly on a public deployment.
MEP_APP_ENV=production
MEP_APP_DEBUG=false
MEP_ALLOW_SELF_SIGNUP=false
MEP_SESSION_IDLE_SECONDS=7200
MEP_MAX_UPLOAD_BYTES=10485760
MEP_PASSWORD_RESET_MINUTES=30
MEP_APP_BASE_URL=https://portal.example.com/MEP_Projects_Version_007.4
MEP_APP_TIMEZONE=Asia/Riyadh
MEP_DEFAULT_CURRENCY=SAR

# Evidence storage. Use local only for XAMPP/development. Production containers
# must use s3 (AWS S3 or an S3-compatible service such as R2/MinIO).
MEP_EVIDENCE_STORAGE_DRIVER=s3
MEP_EVIDENCE_OBJECT_PREFIX=mep/workplan
MEP_EVIDENCE_S3_ENDPOINT=https://s3.amazonaws.com
MEP_EVIDENCE_S3_REGION=us-east-1
MEP_EVIDENCE_S3_BUCKET=replace-with-private-bucket
MEP_EVIDENCE_S3_ACCESS_KEY=replace-with-access-key
MEP_EVIDENCE_S3_SECRET_KEY=replace-with-secret-key
MEP_EVIDENCE_S3_PATH_STYLE=false
# Leave blank for private objects and signed URLs. Set only for a CDN/public bucket.
MEP_EVIDENCE_PUBLIC_BASE_URL=
MEP_EVIDENCE_SIGNED_URL_TTL=900

# MySQL/MariaDB Database Configuration
MEP_DB_CONNECTION=mysql
MEP_DB_HOST=127.0.0.1
MEP_DB_PORT=3306
MEP_DB_NAME=mep_database
MEP_DB_USER=mep_portal
MEP_DB_PASS=replace-with-a-long-random-secret

# SMTP (required for one-time password reset links)
MEP_SMTP_HOST=smtp.example.com
MEP_SMTP_PORT=587
MEP_SMTP_USER=portal@example.com
MEP_SMTP_PASS=replace-with-an-app-password
MEP_SMTP_FROM=portal@example.com
MEP_SMTP_FROM_NAME=MEP Projects Portal
