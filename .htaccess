Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:app|routes|includes|tools)(?:/|$) - [F,L,NC]
RewriteRule ^(?:config\.php|database.*\.sql|\.env.*|ARCHITECTURE\.md|RELEASE_NOTES.*\.md|VERSION\.txt)$ - [F,L,NC]
</IfModule>

<FilesMatch "^(?:\.env|config\.php|database.*\.sql)$">
    Require all denied
</FilesMatch>
